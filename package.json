{
  "name": "claude-nocode-webapp",
  "version": "0.1.0",
  "type": "module",
  "description": "A Vue 3 + Vite PWA scaffold for building with Claude Code",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.5.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10"
  }
}
